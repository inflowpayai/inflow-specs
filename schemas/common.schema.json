{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inflow:conformance:common",
  "$defs": {
    "payment-status-input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id"],
      "oneOf": [
        { "properties": { "api_key": {} }, "required": ["api_key"] },
        { "properties": { "access_token": {} }, "required": ["access_token"] }
      ],
      "properties": {
        "transaction_id": { "type": "string", "minLength": 1 },
        "api_key": { "type": "string", "minLength": 1 },
        "access_token": { "type": "string", "minLength": 1 },
        "reads": { "type": "integer", "minimum": 1, "maximum": 10 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "payment-status-result": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transactionId", "status"],
        "properties": {
          "transactionId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "nextAction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url"],
            "properties": {
              "type": { "const": "authenticate_card" },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 4096 },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "details": { "type": "object" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "result": {}, "error": { "$ref": "#/$defs/error" } },
      "oneOf": [
        { "properties": { "result": {} }, "required": ["result"] },
        { "properties": { "error": {} }, "required": ["error"] }
      ]
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "dirty": { "type": "boolean" }
      }
    },
    "versions": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 160 },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
