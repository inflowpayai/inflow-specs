{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inflow:conformance:report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "contract",
    "sdk",
    "implementation",
    "capabilities",
    "inputs",
    "completed",
    "passed",
    "results"
  ],
  "properties": {
    "report_version": { "const": "1" },
    "contract": { "$ref": "urn:inflow:conformance:common#/$defs/revision" },
    "sdk": { "$ref": "urn:inflow:conformance:common#/$defs/revision" },
    "implementation": { "$ref": "urn:inflow:conformance:implementation" },
    "capabilities": { "$ref": "urn:inflow:conformance:capabilities" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "capabilities", "implementation"],
      "properties": {
        "index": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capabilities": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "implementation": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "completed": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "runner_error": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "suite", "status"],
        "properties": {
          "case_id": { "$ref": "urn:inflow:conformance:common#/$defs/identifier" },
          "suite": { "$ref": "urn:inflow:conformance:common#/$defs/identifier" },
          "status": { "enum": ["passed", "failed", "skipped", "not_run"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "if": { "properties": { "status": { "enum": ["failed", "skipped"] } } },
        "then": { "properties": { "message": {} }, "required": ["message"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "completed": { "const": false } } },
      "then": {
        "required": ["runner_error"],
        "properties": { "runner_error": {}, "passed": { "const": false } }
      },
      "else": {
        "not": { "properties": { "runner_error": {} }, "required": ["runner_error"] },
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "not": { "const": "not_run" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "passed": { "const": true } } },
      "then": {
        "properties": {
          "completed": { "const": true },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "enum": ["passed", "skipped"] } }
            },
            "contains": { "type": "object", "properties": { "status": { "const": "passed" } } }
          }
        }
      }
    }
  ]
}
