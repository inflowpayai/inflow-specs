{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inflow:conformance:adapter-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_version", "sequence", "case_id", "operation", "input"],
  "properties": {
    "adapter_version": { "const": "1" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "case_id": { "$ref": "urn:inflow:conformance:common#/$defs/identifier" },
    "operation": { "$ref": "urn:inflow:conformance:common#/$defs/identifier" },
    "input": { "type": "object" }
  }
}
